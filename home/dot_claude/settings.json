{
  "cleanupPeriodDays": 7,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.docker/**)",
      "Read(**/config/database.yml)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.kube/**)",
      "Read(**/serviceaccount*.json)",
      "Read(**/*secret*.json)",
      "Read(**/*credentials*.json)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "blowfish@blowfish": true
  },
  "extraKnownMarketplaces": {
    "blowfish": {
      "source": {
        "source": "github",
        "repo": "nunocoracao/blowfish"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "hooks": {"SessionStart":[{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '/home/jnobrega/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
}
